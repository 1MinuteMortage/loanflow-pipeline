{
  "name": "Loan",
  "type": "object",
  "properties": {
    "first_name": {
      "type": "string",
      "description": "Borrower's first name"
    },
    "last_name": {
      "type": "string",
      "description": "Borrower's last name"
    },
    "date_of_birth": {
      "type": "string",
      "format": "date",
      "description": "Borrower's date of birth"
    },
    "ssn": {
      "type": "string",
      "description": "Borrower's Social Security Number"
    },
    "employment": {
      "type": "string",
      "description": "Borrower employer / position"
    },
    "income": {
      "type": "number",
      "description": "Borrower annual income"
    },
    "credit_score": {
      "type": "number",
      "description": "Borrower credit score"
    },
    "property_address": {
      "type": "string",
      "description": "Property street address"
    },
    "address_tbd": {
      "type": "boolean",
      "default": false,
      "description": "True when client is in pre-approval and no property is under contract yet"
    },
    "stage": {
      "type": "string",
      "enum": [
        "pending",
        "preapproved",
        "under_contract",
        "needs_review",
        "follow_up"
      ],
      "default": "pending",
      "description": "Current pipeline stage"
    },
    "realtor_name": {
      "type": "string",
      "description": "Name of the realtor who referred the client"
    },
    "realtor_phone": {
      "type": "string",
      "description": "Realtor contact phone number"
    },
    "realtor_email": {
      "type": "string",
      "description": "Realtor contact email"
    },
    "realtor_brokerage": {
      "type": "string",
      "description": "Realtor brokerage name"
    },
    "buyer_agent_name": {
      "type": "string",
      "description": "Buyer agent name"
    },
    "buyer_agent_phone": {
      "type": "string",
      "description": "Buyer agent phone"
    },
    "buyer_agent_email": {
      "type": "string",
      "description": "Buyer agent email"
    },
    "selling_agent_name": {
      "type": "string",
      "description": "Selling agent name"
    },
    "selling_agent_phone": {
      "type": "string",
      "description": "Selling agent phone"
    },
    "selling_agent_email": {
      "type": "string",
      "description": "Selling agent email"
    },
    "appraiser_name": {
      "type": "string",
      "description": "Appraiser name"
    },
    "appraiser_phone": {
      "type": "string",
      "description": "Appraiser phone"
    },
    "appraiser_email": {
      "type": "string",
      "description": "Appraiser email"
    },
    "closing_attorney_name": {
      "type": "string",
      "description": "Closing attorney name"
    },
    "closing_attorney_phone": {
      "type": "string",
      "description": "Closing attorney phone"
    },
    "closing_attorney_email": {
      "type": "string",
      "description": "Closing attorney email"
    },
    "underwriter_name": {
      "type": "string",
      "description": "Underwriter name"
    },
    "underwriter_phone": {
      "type": "string",
      "description": "Underwriter phone"
    },
    "underwriter_email": {
      "type": "string",
      "description": "Underwriter email"
    },
    "needed_items": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "label": {
            "type": "string"
          },
          "completed": {
            "type": "boolean",
            "default": false
          },
          "file_url": {
            "type": "string",
            "description": "Uploaded document URL"
          },
          "file_name": {
            "type": "string",
            "description": "Original uploaded file name"
          }
        }
      },
      "default": [],
      "description": "Pre UnderWrite documents checklist"
    },
    "uw_conditions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "label": {
            "type": "string"
          },
          "completed": {
            "type": "boolean",
            "default": false
          },
          "file_url": {
            "type": "string",
            "description": "Uploaded document URL"
          },
          "file_name": {
            "type": "string",
            "description": "Original uploaded file name"
          }
        }
      },
      "default": [],
      "description": "Underwriting conditions checklist (used once stage is Under Contract)"
    },
    "due_date": {
      "type": "string",
      "format": "date",
      "description": "SLA target date for the current stage"
    },
    "notes": {
      "type": "string",
      "description": "Free-form notes"
    }
  },
  "required": [
    "first_name",
    "last_name"
  ]
}