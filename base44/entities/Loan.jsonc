{
  "name": "Loan",
  "type": "object",
  "properties": {
    "first_name": {
      "type": "string",
      "description": "Borrower's first name"
    },
    "last_name": {
      "type": "string",
      "description": "Borrower's last name"
    },
    "date_of_birth": {
      "type": "string",
      "format": "date",
      "description": "Borrower's date of birth"
    },
    "email": {
      "type": "string",
      "description": "Borrower's email address"
    },
    "ssn": {
      "type": "string",
      "description": "Borrower's Social Security Number"
    },
    "employment": {
      "type": "string",
      "description": "Borrower employer / position"
    },
    "employment_duration": {
      "type": "string",
      "enum": [
        "two_years_plus",
        "two_years_or_less"
      ],
      "description": "How long the borrower has been working with their current employer"
    },
    "income": {
      "type": "number",
      "description": "Borrower annual income (preliminary qualifying income)"
    },
    "credit_score": {
      "type": "number",
      "description": "Borrower credit score"
    },
    "current_residence": {
      "type": "string",
      "description": "Borrower's current residence address"
    },
    "residence_two_years": {
      "type": "boolean",
      "default": false,
      "description": "True when borrower has lived in current residence two years or more"
    },
    "marital_status": {
      "type": "string",
      "enum": [
        "single",
        "married"
      ],
      "description": "Borrower marital status"
    },
    "occupancy_type": {
      "type": "string",
      "enum": [
        "primary",
        "investment"
      ],
      "description": "Whether the property will be a primary residence or investment"
    },
    "us_citizen": {
      "type": "boolean",
      "default": false,
      "description": "True when borrower is a US citizen"
    },
    "va_status": {
      "type": "boolean",
      "default": false,
      "description": "True when borrower has VA eligibility"
    },
    "estimated_available_funds": {
      "type": "number",
      "description": "Borrower estimated available funds for transaction"
    },
    "total_assets": {
      "type": "number",
      "description": "Borrower's total available assets/reserves (Loan Officer section)"
    },
    "total_verified_assets": {
      "type": "number",
      "description": "Borrower's verified total assets (Loan Officer section)"
    },
    "income_calculation": {
      "type": "object",
      "properties": {
        "income_type": {
          "type": "string",
          "enum": [
            "w2",
            "1099"
          ]
        },
        "year_recent": {
          "type": "number"
        },
        "year_recent_amount": {
          "type": "number"
        },
        "year_prior": {
          "type": "number"
        },
        "year_prior_amount": {
          "type": "number"
        },
        "calculated_income": {
          "type": "number"
        },
        "override_amount": {
          "type": "number"
        },
        "override_reason": {
          "type": "string"
        },
        "final_income": {
          "type": "number"
        },
        "loan_officer_name": {
          "type": "string"
        },
        "completed_date": {
          "type": "string",
          "format": "date"
        },
        "explanation_text": {
          "type": "string"
        }
      },
      "description": "Loan Officer income calculation record (source figures, methodology, and audit info)"
    },
    "property_address": {
      "type": "string",
      "description": "Property street address"
    },
    "address_tbd": {
      "type": "boolean",
      "default": false,
      "description": "True when client is in pre-approval and no property is under contract yet"
    },
    "stage": {
      "type": "string",
      "enum": [
        "pending",
        "preapproved",
        "under_contract",
        "ctc",
        "closed",
        "needs_review",
        "follow_up"
      ],
      "default": "pending",
      "description": "Current pipeline stage"
    },
    "assigned_to_id": {
      "type": "string",
      "description": "User id of the team member assigned to this loan"
    },
    "assigned_to_name": {
      "type": "string",
      "description": "Display name of the team member assigned to this loan"
    },
    "loan_officer_id": {
      "type": "string",
      "description": "User id of the assigned loan officer"
    },
    "loan_officer_name": {
      "type": "string",
      "description": "Display name of the assigned loan officer"
    },
    "loan_processor_id": {
      "type": "string",
      "description": "User id of the assigned loan processor"
    },
    "loan_processor_name": {
      "type": "string",
      "description": "Display name of the assigned loan processor"
    },
    "preapproval_amount": {
      "type": "number",
      "description": "Pre-approved loan dollar amount"
    },
    "ltv": {
      "type": "number",
      "description": "Loan-to-value ratio (percentage)"
    },
    "sales_price": {
      "type": "number",
      "description": "Property sales price"
    },
    "sellers_concession": {
      "type": "number",
      "description": "Seller concession amount needed (pre-approval estimate)"
    },
    "sellers_concession_on_contract": {
      "type": "number",
      "description": "Seller concession amount on the actual purchase contract (Under Contract)"
    },
    "hoa_dues": {
      "type": "number",
      "description": "Monthly HOA dues"
    },
    "property_type": {
      "type": "string",
      "enum": [
        "Detached Home",
        "Attached Home",
        "Condominium"
      ],
      "description": "Property type classification"
    },
    "unit_count": {
      "type": "string",
      "enum": [
        "Single-Family",
        "Duplex",
        "Triplex",
        "Fourplex"
      ],
      "description": "Number of units at the property"
    },
    "lock_date": {
      "type": "string",
      "format": "date",
      "description": "Interest rate lock date"
    },
    "loan_number": {
      "type": "string",
      "description": "Lender/Loan number"
    },
    "loan_type": {
      "type": "string",
      "enum": [
        "DPA FHA",
        "DPA Conventional",
        "30 Year FHA",
        "FHA 203k",
        "30 Year Conventional",
        "Jumbo",
        "DSCR"
      ],
      "description": "Loan program type"
    },
    "realtor_name": {
      "type": "string",
      "description": "Name of the realtor who referred the client"
    },
    "realtor_phone": {
      "type": "string",
      "description": "Realtor contact phone number"
    },
    "realtor_email": {
      "type": "string",
      "description": "Realtor contact email"
    },
    "realtor_brokerage": {
      "type": "string",
      "description": "Realtor brokerage name"
    },
    "buyer_agent_name": {
      "type": "string",
      "description": "Buyer agent name"
    },
    "buyer_agent_phone": {
      "type": "string",
      "description": "Buyer agent phone"
    },
    "buyer_agent_email": {
      "type": "string",
      "description": "Buyer agent email"
    },
    "selling_agent_name": {
      "type": "string",
      "description": "Selling agent name"
    },
    "selling_agent_phone": {
      "type": "string",
      "description": "Selling agent phone"
    },
    "selling_agent_email": {
      "type": "string",
      "description": "Selling agent email"
    },
    "appraiser_name": {
      "type": "string",
      "description": "Appraiser name"
    },
    "appraiser_phone": {
      "type": "string",
      "description": "Appraiser phone"
    },
    "appraiser_email": {
      "type": "string",
      "description": "Appraiser email"
    },
    "closing_attorney_name": {
      "type": "string",
      "description": "Closing attorney office name"
    },
    "closing_attorney_representative_name": {
      "type": "string",
      "description": "Closing attorney representative name"
    },
    "closing_attorney_phone": {
      "type": "string",
      "description": "Closing attorney phone"
    },
    "closing_attorney_email": {
      "type": "string",
      "description": "Closing attorney email"
    },
    "underwriter_name": {
      "type": "string",
      "description": "Underwriter name"
    },
    "underwriter_phone": {
      "type": "string",
      "description": "Underwriter phone"
    },
    "underwriter_email": {
      "type": "string",
      "description": "Underwriter email"
    },
    "needed_items": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "label": {
            "type": "string"
          },
          "completed": {
            "type": "boolean",
            "default": false
          },
          "file_url": {
            "type": "string",
            "description": "Uploaded document URL (legacy single-file)"
          },
          "file_name": {
            "type": "string",
            "description": "Original uploaded file name (legacy single-file)"
          },
          "files": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "file_url": {
                  "type": "string"
                },
                "file_name": {
                  "type": "string"
                }
              }
            },
            "default": [],
            "description": "All uploaded documents for this condition"
          }
        }
      },
      "default": [],
      "description": "Pre UnderWrite documents checklist"
    },
    "uw_conditions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "label": {
            "type": "string"
          },
          "completed": {
            "type": "boolean",
            "default": false
          },
          "file_url": {
            "type": "string",
            "description": "Uploaded document URL (legacy single-file)"
          },
          "file_name": {
            "type": "string",
            "description": "Original uploaded file name (legacy single-file)"
          },
          "files": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "file_url": {
                  "type": "string"
                },
                "file_name": {
                  "type": "string"
                }
              }
            },
            "default": [],
            "description": "All uploaded documents for this condition"
          }
        }
      },
      "default": [],
      "description": "Underwriting conditions checklist (used once stage is Under Contract)"
    },
    "initial_conditions_url": {
      "type": "string",
      "description": "Uploaded initial UW conditions document URL"
    },
    "initial_conditions_name": {
      "type": "string",
      "description": "Original uploaded initial conditions file name"
    },
    "due_date": {
      "type": "string",
      "format": "date",
      "description": "SLA target date for the current stage"
    },
    "finance_contingency_date": {
      "type": "string",
      "format": "date",
      "description": "Finance contingency date"
    },
    "closing_date": {
      "type": "string",
      "format": "date",
      "description": "Closing date"
    },
    "notes": {
      "type": "string",
      "description": "Free-form notes"
    }
  },
  "required": [
    "first_name",
    "last_name"
  ]
}